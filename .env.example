# Публичные параметры клиента (попадают в сборку приложения — только publishable/anon ключ!)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_ENABLE_GOOGLE_AUTH=false

# ВНИМАНИЕ: секреты LiveKit НЕ указываются здесь.
# Они задаются только как секреты Supabase Edge Functions:
#   LIVEKIT_URL=wss://your-project.livekit.cloud
#   LIVEKIT_API_KEY=...
#   LIVEKIT_API_SECRET=...
