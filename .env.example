# Публичные параметры клиента (попадают в сборку приложения — только publishable/anon ключ!)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_ENABLE_GOOGLE_AUTH=false

# ВНИМАНИЕ: ключи голосового сервера Cloudflare Realtime SFU НЕ указываются здесь.
# Они задаются только как секреты Supabase Edge Functions (функция voice-sfu):
#   CF_SFU_APP_ID=...
#   CF_SFU_APP_TOKEN=...
