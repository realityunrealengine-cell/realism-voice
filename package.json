{
  "name": "realism-voice",
  "productName": "Realism Voice",
  "version": "1.2.0",
  "description": "Realism Voice — голосовой и текстовый мессенджер для Windows",
  "author": "Realism Voice",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n vite,electron -c magenta,cyan \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:electron && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p supabase/functions/tsconfig.json",
    "start": "electron .",
    "icons": "node scripts/generate-icons.mjs",
    "sql:bundle": "node scripts/bundle-sql.mjs",
    "test:sql": "node scripts/test-sql.mjs && node scripts/test-sql-upgrade.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "pack": "npm run build && electron-builder --win dir --x64 --publish never",
    "test:updater": "node scripts/test-updater.cjs",
    "test:release": "node scripts/test-release-publish.mjs",
    "update-key:generate": "node scripts/generate-update-key.mjs",
    "update-test:build": "node scripts/update-test.mjs build",
    "update-test:serve": "node scripts/update-test.mjs serve",
    "test": "vitest run",
    "test:sfu-live": "electron scripts/sfu-smoke/main.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.67.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.5",
    "zustand": "^5.0.16"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "uiohook-napi": false
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "updatePublicKeys": [
    "MCowBQYDK2VwAyEAE2z6CeSolIZJMfKzOK6WSdSXbjK7CObk+bhHSRd90sA="
  ],
  "build": {
    "appId": "com.realism.voice",
    "productName": "Realism Voice",
    "copyright": "Copyright © 2026 Realism Voice",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "realityunrealengine-cell",
        "repo": "realism-voice-releases",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Realism Voice",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Realism Voice",
      "uninstallDisplayName": "Realism Voice",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "RealismVoice-Setup.exe",
      "language": "1049"
    }
  }
}
